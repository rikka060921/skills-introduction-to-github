# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Android specific
*.iml
.gradle
/local.properties
/.idea/
/build
/captures
.externalNativeBuild
.cxx
*.apk
*.ap_
*.aab

# Gradle files
.gradle/
build/

# Android Studio Navigation editor temp files
.navigation/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
